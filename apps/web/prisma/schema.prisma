generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ResumeHistory {
  id              String   @id @default(uuid())
  userId          String
  originalData    Json
  transformedData Json
  universe        String
  isFavorite      Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([userId])
}
